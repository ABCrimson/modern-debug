{
  "name": "modern-debug",
  "version": "0.0.1",
  "description": "Sub-2KB ESM-only universal diagnostic logger: debug-compatible namespaces, structured NDJSON, OpenTelemetry trace correlation, AsyncLocalStorage scoping.",
  "license": "MIT",
  "author": "Albert Badalov",
  "homepage": "https://abcrimson.github.io/modern-debug/",
  "bugs": {
    "url": "https://github.com/ABCrimson/modern-debug/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ABCrimson/modern-debug.git",
    "directory": "packages/modern-debug"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "require": {
        "types": "./dist/compat-cjs.d.cts",
        "default": "./dist/compat-cjs.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./compat": {
      "types": "./dist/compat.d.ts",
      "default": "./dist/compat.js"
    },
    "./otel": {
      "types": "./dist/otel.d.ts",
      "default": "./dist/otel.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.1"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.src.json --noEmit",
    "test": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "coverage": "vitest run --coverage --project node",
    "size": "size-limit",
    "publint": "publint --pack npm --strict",
    "attw": "attw --pack . --profile esm-only --ignore-rules false-cjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@opentelemetry/api": "1.10.0",
    "@playwright/test": "1.65.0-alpha-2026-10-31",
    "@size-limit/preset-small-lib": "14.3.0",
    "@types/debug": "4.1.13",
    "@types/node": "26.6.6",
    "@vitest/browser": "5.1.0-beta.1",
    "@vitest/browser-playwright": "5.1.0-beta.1",
    "@vitest/coverage-v8": "5.1.0-beta.1",
    "debug": "4.4.3",
    "fast-check": "4.10.2",
    "publint": "0.3.25",
    "size-limit": "14.3.0",
    "tsdown": "0.23.4",
    "typescript": "7.1.0-dev.20261031.1",
    "typescript-legacy": "npm:typescript@5.8.3",
    "vitest": "5.1.0-beta.1"
  },
  "keywords": [
    "debug",
    "log",
    "logger",
    "ndjson",
    "opentelemetry",
    "esm",
    "workers"
  ]
}
