{
  "name": "modern-debug-monorepo",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=24.22.2"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "biome check .",
    "verify": "turbo run typecheck lint knip test size publint attw",
    "knip": "knip",
    "changeset": "changeset",
    "prepare": "lefthook install",
    "release": "pnpm -C packages/modern-debug build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@changesets/cli": "3.0.3",
    "knip": "6.44.0",
    "lefthook": "2.2.2",
    "turbo": "2.11.11-canary.1"
  }
}
